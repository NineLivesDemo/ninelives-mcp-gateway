# Copy this file to ignored bootstrap.ini after opening an Azure Bastion tunnel.
# Keep the tunnel in a separate terminal while Ansible runs.
# The operator SSH key is passed with ansible-playbook --private-key, not stored here.

[automation]
automation_platform ansible_host=127.0.0.1 ansible_port=2222 ansible_user=azureuser

[automation:vars]
ansible_ssh_common_args='-o StrictHostKeyChecking=yes'
