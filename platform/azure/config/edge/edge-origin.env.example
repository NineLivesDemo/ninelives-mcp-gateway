# Private Registry VM address. Use the ACA ingress host here when the rollback
# deployment is active instead.
REGISTRY_ORIGIN_HOST=10.60.4.4
REGISTRY_ORIGIN_SCHEME=http
REGISTRY_ORIGIN_PORT=8080

# Public host name expected by the Registry service and its TLS configuration.
REGISTRY_HOST_HEADER=registry-github.adriangarciacruz.com

# Private Keycloak VM address. Use the ACA ingress host here when the rollback
# deployment is active instead.
KEYCLOAK_ORIGIN_HOST=10.60.5.4
KEYCLOAK_ORIGIN_SCHEME=http
KEYCLOAK_ORIGIN_PORT=8080

# Public host name expected by Keycloak and its OIDC metadata.
KEYCLOAK_HOST_HEADER=keycloak.adriangarciacruz.com
