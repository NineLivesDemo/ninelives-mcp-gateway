[Unit]
Description=Render platform bootstrap secrets from Azure Key Vault
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/platform-secret-sync
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/etc/platform/secrets /etc/platform/tls

[Install]
WantedBy=multi-user.target
